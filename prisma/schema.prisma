generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("FIELD_AGENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedFields Field[]        @relation("FieldAgent")
  updates        FieldUpdate[]
  claimedInvite  AgentInvite?   @relation("InviteClaim")
}

model Field {
  id           String      @id @default(cuid())
  name         String
  cropType     String
  plantingDate DateTime
  stage        String      @default("PLANTED") // Enums mocked with String in SQLite
  sizeHectares Float?
  location     String?     // e.g. county or GPS string
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  agentId      String?
  agent        User?       @relation("FieldAgent", fields: [agentId], references: [id])
  updates      FieldUpdate[]
}

model FieldUpdate {
  id        String   @id @default(cuid())
  fieldId   String
  agentId   String
  stage     String
  notes     String?
  createdAt DateTime @default(now())

  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  agent     User     @relation(fields: [agentId], references: [id])
}

model AgentInvite {
  id          String    @id @default(cuid())
  email       String    @unique
  token       String    @unique
  role        String    @default("FIELD_AGENT")
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  claimedBy   User?     @relation("InviteClaim", fields: [claimedById], references: [id])
  claimedById String?   @unique
}
